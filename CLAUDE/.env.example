# ---------------------------------------------------------------------------
# Base Lucas — módulo Node.js do 4M&C Market
# Copie para .env e preencha. NUNCA commitar o .env preenchido.
# ---------------------------------------------------------------------------

PORT=3000

# --- Banco: MySQL (HostGator). Se faltar ou falhar, cai sozinho no SQLite ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_POOL=10

# Caminho do SQLite usado no fallback (Render)
SQLITE_PATH=./data/baselucas.db

# --- Tabela de pedidos do 4M&C (SOMENTE LEITURA) ---
# O Base Lucas nunca escreve aqui. Ajuste os nomes ao schema real.
BASE_ORDERS_TABLE=orders
BASE_ORDERS_COL_ID=id
BASE_ORDERS_COL_EXTERNAL_ID=external_id
BASE_ORDERS_COL_CUSTOMER=customer_name
BASE_ORDERS_COL_EMAIL=customer_email
BASE_ORDERS_COL_PHONE=customer_phone
BASE_ORDERS_COL_TOTAL=total_amount
BASE_ORDERS_COL_STATUS=status_name
BASE_ORDERS_COL_CHANNEL=channel_name
BASE_ORDERS_COL_ITEMS=items_json
BASE_ORDERS_COL_CREATED_AT=created_at
BASE_ORDERS_COL_SHIPPING_ID=shipping_id
BASE_ORDERS_COL_TRACKING=tracking_number

# --- CORS: origens do frontend ---
BASE_ALLOWED_ORIGINS=https://controleestoque4mec.pro,http://localhost:3000,http://localhost:5173

# --- Mercado Livre ---
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://fourmc-market-api.onrender.com/api/v1/base/ml/callback
ML_FEED_BASE_URL=https://fourmc-market-api.onrender.com/api/base-antigravity/ml
# true = recusa qualquer escrita no ML. Só liberar após homologação.
ML_READ_ONLY=true

# --- Bling ERP v3 ---
# true = recusa criar pedido de venda / emitir NF-e.
BLING_READ_ONLY=true
NFE_EMIT_ENABLED=false

# --- Impressão ZPL: dry_run | raw | cups ---
ZPL_PRINT_MODE=dry_run
ZPL_PRINTER_HOST=127.0.0.1
ZPL_PRINTER_PORT=9100
ZPL_CUPS_QUEUE=zebra
ZPL_PRINT_TIMEOUT_SEC=8
ZPL_DRY_RUN_DIR=./var/zpl_dry_run

# --- Cron de sincronização ---
BASE_AUTO_SYNC=true
BASE_SYNC_INTERVAL_MS=300000
