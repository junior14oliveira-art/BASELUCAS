# BaseLinker Omnichannel Engine — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais.

# BaseLinker API Token — gere em: Account & other → My account → API
BASELINKER_API_TOKEN=SEU_TOKEN_AQUI
BASELINKER_TOKEN=SEU_TOKEN_AQUI

# Database
# SQLite (desenvolvimento local):
DATABASE_URL=sqlite+aiosqlite:///./omnichannel_real.db
USE_SQLITE=true
# PostgreSQL (produção):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/omnichannel_db
# USE_SQLITE=false

# Servidor
PORT=8000
HOST=0.0.0.0

# Segurança JWT — use um valor forte e aleatório em produção
SECRET_KEY=GERE_UMA_CHAVE_FORTE_AQUI
ALGORITHM=HS256

# CORS — separe múltiplas origens por vírgula
ALLOWED_ORIGINS=http://localhost:3000

# Ambiente: local | production
ENVIRONMENT=local
MOCK_INTEGRATIONS=false

# Redis (Docker Compose padrão)
REDIS_URL=redis://localhost:6379/0

# RabbitMQ (Docker Compose padrão)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# OpenAI (opcional — para AssistantAgent com LLM real)
# OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Mercado Livre
# ---------------------------------------------------------------------------
# Crie o app em https://developers.mercadolivre.com.br/devcenter
# O "Redirect URI" cadastrado no DevCenter precisa ser IDÊNTICO ao ML_REDIRECT_URI abaixo.
ML_CLIENT_ID=SEU_APP_ID_AQUI
ML_CLIENT_SECRET=SEU_SECRET_KEY_AQUI
ML_REDIRECT_URI=http://localhost:8000/api/v1/ml/auth/callback

# Site: MLB=Brasil, MLA=Argentina, MLM=México, MLC=Chile, MCO=Colômbia
ML_SITE_ID=MLB

# Escrita no ML bloqueada até homologação (default seguro)
ML_READ_ONLY=true

# Segredo opcional para validar webhooks
ML_WEBHOOK_SECRET=

# Feed read-only 4MC (pedidos operacionais — separado do OAuth direto)
# ML_FEED_BASE_URL=https://fourmc-market-api.onrender.com/api/base-antigravity/ml

# ---------------------------------------------------------------------------
# Bling ERP API v3 — Macro Fiscal (Etapa 2)
# Cadastre app em developer.bling.com.br
# Defaults seguros: BLING_READ_ONLY=true, NFE_EMIT_ENABLED=false
# ---------------------------------------------------------------------------
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI=http://localhost:8000/api/v1/bling/callback
BLING_ACCOUNT_KEY=4mc
BLING_READ_ONLY=true
NFE_EMIT_ENABLED=false
BLING_AUTO_PUSH_ON_PAID=true
BLING_NATUREZA_OPERACAO_ID=0

