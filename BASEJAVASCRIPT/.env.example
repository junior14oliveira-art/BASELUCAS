PORT=8000
NODE_ENV=development

# Banco: se MYSQL_* estiver preenchido usa MySQL (HostGator); senão SQLite (Render/local)
DATABASE_URL=sqlite:./data/baselucas.db
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Feed ML 4MC (read-only bridge)
ML_FEED_BASE_URL=https://fourmc-market-api.onrender.com/api/base-antigravity/ml
ML_FEED_URL=https://fourmc-market-api.onrender.com/api/base-antigravity/ml/feed
ML_FEED_ORDERS_URL=https://fourmc-market-api.onrender.com/api/base-antigravity/ml/orders
ML_READ_ONLY=true

# Bling
BLING_READ_ONLY=true
NFE_EMIT_ENABLED=false
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_ACCOUNT_KEY=4mc

# ZPL / Expedição
ZPL_PRINT_MODE=dry_run
ZPL_RAW_HOST=
ZPL_RAW_PORT=9100

# Auto-sync (minutos)
ML_AUTO_SYNC_MINUTES=5
